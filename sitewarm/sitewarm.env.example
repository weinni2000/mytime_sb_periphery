# Copy to sitewarm.env and set the public website's sitemap URL.
SITEMAP_URL=https://example.com/sitemap.xml

# Scan up to this many allowed URLs, following nested sitemap indexes.
SITEWARM_TOP=1000000
# Applies to sitemap, robots.txt and page requests across both browser profiles.
SITEWARM_RPS=2
SITEWARM_CONCURRENCY=2
# 0 makes one warming attempt per URL/profile instead of waiting for a cache HIT.
# Use e.g. 30s to retry MISS/STALE responses and verify the warmed cache.
SITEWARM_MAX_WAIT=0
SITEWARM_RETRY_INTERVAL=10s
SITEWARM_RUN_TIMEOUT=1h
SITEWARM_ACCEPT_LANGUAGE='de-AT,de;q=0.9,en;q=0.8'
SITEWARM_FAIL_ON=miss,client-error,error,incomplete,redirect-error,challenged
SITEWARM_FORMAT=table

# Optional overrides:
# SITEWARM_BIN=/usr/local/bin/sitewarm
# SITEWARM_REPORT_DIR=reports
